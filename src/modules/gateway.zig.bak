pub fn init() !void {
    const allocator = core.getAllocator();
    gw_root.g_gateway = gw_root.GatewayModule.init(allocator);
    var gw = &gw_root.g_gateway.?;

    // Auth routes (no auth required)
    try gw.addRoute(.POST, "/auth/get_user_token", handleGetUserToken, false);
    try gw.addRoute(.POST, "/auth/get_admin_token", handleGetAdminToken, false);
    try gw.addRoute(.POST, "/auth/parse_token", handleParseToken, false);
    try gw.addRoute(.POST, "/auth/force_logout", handleForceLogout, true);

    // OpenChat-compatible auth routes
    try gw.addRoute(.POST, "/account/login", handleAccountLogin, false);
    try gw.addRoute(.POST, "/account/register", handleAccountRegister, false);
