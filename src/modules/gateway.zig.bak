// Re-export public API
pub const info = gw_root.info;
pub const HttpMethod = model.HttpMethod;
pub const HttpRequest = model.HttpRequest;
pub const HttpResponse = model.HttpResponse;
pub const Route = model.Route;
pub const RouteHandler = model.RouteHandler;
pub const GatewayModule = gw_root.GatewayModule;

pub fn deinit() void {
    gw_root.deinit();
}

pub fn getGateway() *gw_root.GatewayModule {
    return gw_root.getGateway();
}

pub fn setHttpIo(io: std.Io) void {
    gw_root.setHttpIo(io);
}

pub fn startHttpServer() !void {
    return gw_root.startHttpServer();
}

// Type aliases for handlers (keep handler code unchanged)
