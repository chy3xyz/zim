pub fn init() !void {
    const allocator = core.getAllocator();
    gw_root.g_gateway = gw_root.GatewayModule.init(allocator);
    var gw = &gw_root.g_gateway.?;

    // Auth routes (no auth required)
    try gw.addRoute(.POST, "/auth/get_user_token", handlers_auth.handleGetUserToken, false);
    try gw.addRoute(.POST, "/auth/get_admin_token", handlers_auth.handleGetAdminToken, false);
    try gw.addRoute(.POST, "/auth/parse_token", handlers_auth.handleParseToken, false);
    try gw.addRoute(.POST, "/auth/force_logout", handlers_auth.handleForceLogout, true);

    // OpenChat-compatible auth routes
